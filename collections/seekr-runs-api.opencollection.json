          "info": {
            "name": "List Runs Endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://flow.seekr.com/v1/threads/:thread_id/runs",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "thread_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List runs in a thread."
        },
        {
          "info": {
            "name": "Run Agent",
            "type": "http"
