{
  "opencollection": "1.0.0",
  "info": {
    "name": "SeekrFlow Functions API",
    "version": "5.45.1"
  },
  "items": [
    {
      "info": {
        "name": "Functions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Python Function Endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://flow.seekr.com/v1/functions",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List all python functions."
        },
        {
          "info": {
            "name": "Upload Python Function",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://flow.seekr.com/v1/functions",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Upload a new Python function for the authenticated team."
        },
        {
          "info": {
            "name": "Get Python Function Endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://flow.seekr.com/v1/functions/:function_id",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a Python function by its ID for the authenticated team."
        },
        {
          "info": {
            "name": "Update Python Function Endpoint",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://flow.seekr.com/v1/functions/:function_id",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Updates existing Python function. Supports updating the description, the code, or both."
        },
        {
          "info": {
            "name": "Delete Python Function Endpoint",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://flow.seekr.com/v1/functions/:function_id",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Delete a Python function by its ID for the authenticated team."
        },
        {
          "info": {
            "name": "Validate Function Ids",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://flow.seekr.com/v1/internal/functions/validate-function-ids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate that the provided function IDs exist and belong to the team (if provided)."
        },
        {
          "info": {
            "name": "Get Functions By Ids",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://flow.seekr.com/v1/internal/functions/by-ids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve Python functions by a list of IDs."
        }
      ]
    }
  ],
  "bundled": true
}