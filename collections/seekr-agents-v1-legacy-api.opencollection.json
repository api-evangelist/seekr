            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Promote"
        },
        {
          "info": {
            "name": "Demote",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://flow.seekr.com/v1/flow/agents/:agent_id/demote",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Demote"
        },
        {
          "info": {
            "name": "Preview agent update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://flow.seekr.com/v1/flow/agents/:agent_id/diff",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Preview the changes a patch request would make to an agent without applying them. Returns a before-and-after diff of the affected fields."
        },
        {
          "info": {
            "name": "Update Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://flow.seekr.com/v1/flow/internal/agents/:agent_id/update-status",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "An internal-only endpoint (no built-in auth validation) to update the agent's status in the DB, if it exists.\n\nIf the provided status is 'Active', and the Agent's current status is NOT 'Active', the `last_deployed_at` field\nis also updated in the DB to reflect the current date/time.\n\nIf the provided status is changed to 'Failed' from any other status, the Agent yaml is deleted from the git repo,\nand the status is updated to 'Failed' in the DB.\n\nArguments:\n    agent_id: the ID of the agent to upd"
        }
      ]
    }
  ],
  "bundled": true
}