            "method": "GET",
            "url": "https://flow.seekr.com/v1/flow/alignment",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deprecated. List all alignment jobs for the user.\n\nUse ``GET /v1/flow/data-jobs`` instead."
        },
        {
          "info": {
            "name": "Ingestion List",
            "type": "http"
