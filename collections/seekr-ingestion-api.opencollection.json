{
  "opencollection": "1.0.0",
  "info": {
    "name": "SeekrFlow Ingestion API",
    "version": "5.108.1"
  },
  "items": [
    {
      "info": {
        "name": "Ingestion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ingestion List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://flow.seekr.com/v1/flow/ingestion",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List all ingestion jobs for the user."
        },
        {
          "info": {
            "name": "Ingest Files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://flow.seekr.com/v1/flow/ingestion",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Convert PDF files to Markdown using the ingestion service."
        },
        {
          "info": {
            "name": "Ingestion Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://flow.seekr.com/v1/flow/ingestion/:ingestion_job_id",
            "params": [
              {
                "name": "ingestion_job_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get ingestion job with file records and queue positions."
        }
      ]
    }
  ],
  "bundled": true
}